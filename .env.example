# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGIN="*"

# PostgreSQL / Prisma (for Docker Compose & standalone PostgreSQL deployment)
DATABASE_URL="postgresql://warehouse:warehouse_secret@localhost:5432/smart_warehouse?schema=public"

# MQTT Broker (Mosquitto)
# Leave empty in preview mode if no external Mosquitto broker is running;
# In Docker Compose, set to mqtt://mosquitto:1883
MQTT_BROKER_URL=""
MQTT_USERNAME="warehouse_iot"
MQTT_PASSWORD="iot_broker_password"

# Security & Auth
JWT_SECRET="change_this_to_a_strong_32_char_secret_key"
DEVICE_API_KEYS="wh-rfid-a-key-01:RFID-GATE-A-01,wh-barcode-b-key-02:BARCODE-GATE-B-01,wh-prox-c-key-03:PROX-GATE-C-01,wh-rfid-c-key-04:RFID-GATE-C-02"

# Gemini API (optional if extending with AI analytics)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
